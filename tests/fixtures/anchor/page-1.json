    9.9626,
    143.866,
    251.035
   ],
   "width": 324.26469732,
   "height": 9.9626,
   "hasEOL": true
  },
  {
   "str": "best models from the literature. We show that the Transformer generalizes well to",
   "transform": [
    9.9227496,
