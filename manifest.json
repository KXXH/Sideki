{
  "manifest_version": 3,
  "name": "Sideki",
  "version": "1.5.1",
  "description": "AI-powered side panel assistant",
  "permissions": ["sidePanel", "activeTab", "tabs", "tabGroups", "storage", "unlimitedStorage", "alarms", "scripting", "debugger", "webNavigation", "bookmarks", "history", "downloads", "topSites", "notifications", "contextMenus", "identity", "offscreen", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["<all_urls>"],
  "commands": {
    "add-to-context": {
      "suggested_key": { "default": "Ctrl+Shift+L", "mac": "Command+Shift+L" },
      "description": "Open Sideki and add selected text"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'",
    "sandbox": "sandbox allow-scripts; default-src 'none'; script-src 'unsafe-inline' https:; style-src 'unsafe-inline' https:; img-src data: blob: https:; font-src data: blob: https:; media-src data: blob: https:; connect-src https: wss:; frame-src 'none'; object-src 'none'; form-action 'none'; base-uri 'none'"
  },
  "sandbox": {
    "pages": ["src/viz/sandbox.html", "src/viz/sandbox-online.html"]
  },
  "action": {
    "default_title": "Open Sideki"
  },
  "options_ui": {
    "page": "src/options/index.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [{
    "resources": ["src/preview/index.html"],
    "matches": ["<all_urls>"]
  }],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
